# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=db
DB_SCHEMA=public



# JWT / 鉴权
JWT_SECRET=dev-secret-please-change
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# 服务端口
SERVER_PORT=7562


# 日志目录
LOG_DIR=logs

# 上传文件目录
UPLOAD_DIR=uploads

# 前端构建产物目录（存在时由后端直接托管页面，生产/Docker 使用）
WEB_DIST_DIR=web/dist

# Debug 模式（true 时日志级别为 Debug，会输出所有 SQL 语句和参数）
DEBUG=false

